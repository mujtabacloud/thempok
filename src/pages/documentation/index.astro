---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import { getDocSections } from '../../utils/content';
import { getRelativePath } from '../../data/site';

const docSections = await getDocSections();
---

<BaseLayout
  title="Documentation — Guides & References"
  description="Comprehensive technical guides, tutorials, and architecture references for building with Thempok themes and Astro."
>
  <div class="docs-landing-header">
    <div class="container header-inner">
      <div class="page-badge-wrap">
        <Badge variant="brand">Thempok Docs v1.0</Badge>
      </div>
      <h1 class="page-title">Documentation & Guides</h1>
      <p class="page-subtitle">
        Everything you need to clone, customize, style, and deploy high-performance Astro themes.
      </p>

      <!-- Quick Search / Filter Bar -->
      <div class="docs-search-box">
        <span class="search-icon">
          <Icon name="search" size={18} />
        </span>
        <input
          id="docs-search-input"
          type="search"
          placeholder="Search guides, deployment, CSS variables, components..."
          class="docs-search-input"
          aria-label="Search documentation"
        />
      </div>
    </div>
  </div>

  <section class="docs-body-section">
    <div class="container">
      <!-- Quickstart Hero Card -->
      <div class="card quickstart-hero-card">
        <div class="quickstart-left">
          <div class="quickstart-badge">
            <Icon name="sparkles" size={14} />
            <span>Recommended First Step</span>
          </div>
          <h2 class="quickstart-title">Quick Start in 3 Minutes</h2>
          <p class="quickstart-desc">
            Learn the fastest path to selecting a theme, initializing your local development server, and previewing with hot module replacement.
          </p>
          <div class="quickstart-actions">
            <a href={getRelativePath('/documentation/getting-started/')} class="btn btn-primary">
              <span>Read Quick Start Guide</span>
              <Icon name="arrow-right" size={15} />
            </a>
            <a href={getRelativePath('/documentation/theme-structure/')} class="btn btn-secondary">
              Theme Architecture
            </a>
          </div>
        </div>

        <div class="quickstart-terminal">
          <div class="terminal-bar">
            <span class="dot r"></span>
            <span class="dot y"></span>
            <span class="dot g"></span>
            <span class="t-title">bash — 80x24</span>
          </div>
          <div class="terminal-body">
            <p><span class="p-green">$</span> npm create astro@latest</p>
            <p class="p-dim">&gt; Where should we create your new project? ./my-site</p>
            <p><span class="p-green">$</span> cd my-site &amp;&amp; npm run dev</p>
            <p class="p-accent">&#10003; Local: http://localhost:4321</p>
          </div>
        </div>
      </div>

      <!-- Sections Grid -->
      <div class="doc-categories-grid" id="doc-cards-grid">
        {docSections.map((section) => (
          <div class="doc-category-block" data-category-block>
            <div class="category-header">
              <h2 class="category-title">{section.title}</h2>
              <span class="category-count">{section.items.length} guides</span>
            </div>

            <div class="guides-subgrid">
              {section.items.map((item) => (
                <a
                  href={getRelativePath(`/documentation/${item.slug}/`)}
                  class="card card-hoverable guide-card"
                  data-guide-card
                  data-guide-title={item.title.toLowerCase()}
                  data-guide-desc={item.description.toLowerCase()}
                >
                  <div class="guide-card-top">
                    <span class="guide-icon">
                      <Icon name="file-text" size={18} />
                    </span>
                    {item.badge && <Badge variant="brand">{item.badge}</Badge>}
                    <span class="guide-time">{item.readTime || '3 min'}</span>
                  </div>

                    <h3 class="guide-card-title">{item.title}</h3>
                    <p class="guide-card-desc">{item.description}</p>

                    <div class="guide-card-footer">
                      <span class="read-guide-link">
                        <span>Read guide</span>
                        <Icon name="arrow-right" size={13} />
                      </span>
                    </div>
                  </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- FAQ Section -->
      <section class="docs-faq-section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Common Questions</h2>
            <p class="section-subtitle">Quick answers to frequently asked implementation questions.</p>
          </div>
        </div>

        <div class="faq-grid">
          <div class="card faq-card">
            <h3 class="faq-question">Can I use these themes for commercial client projects?</h3>
            <p class="faq-answer">
              Yes, absolutely! All Thempok themes are licensed under the MIT License, which gives you complete freedom to use, modify, and distribute them for commercial and personal projects.
            </p>
          </div>

          <div class="card faq-card">
            <h3 class="faq-question">Do Thempok themes require a Node.js backend server in production?</h3>
            <p class="faq-answer">
              No. Astro generates 100% static HTML, CSS, and assets at build time. You can host them on free static platforms like GitHub Pages, Cloudflare Pages, or Netlify with zero server maintenance.
            </p>
          </div>

          <div class="card faq-card">
            <h3 class="faq-question">How does dark mode work without blinking or flashing?</h3>
            <p class="faq-answer">
              We execute a synchronous 5-line inline script inside the HTML <code>&lt;head&gt;</code> before the DOM is painted. It reads from <code>localStorage</code> or system preference and applies <code>data-theme</code> immediately.
            </p>
          </div>

          <div class="card faq-card">
            <h3 class="faq-question">Can I integrate React, Vue, or Svelte components?</h3>
            <p class="faq-answer">
              Yes. Astro has first-class support for UI frameworks. You can run <code>npx astro add react</code> or <code>npx astro add vue</code> to include interactive widgets wherever needed.
            </p>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('docs-search-input');
    const guideCards = document.querySelectorAll('[data-guide-card]');
    const categoryBlocks = document.querySelectorAll('[data-category-block]');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();

        guideCards.forEach((card) => {
          const title = card.getAttribute('data-guide-title') || '';
          const desc = card.getAttribute('data-guide-desc') || '';
          const matches = !query || title.includes(query) || desc.includes(query);
          card.style.display = matches ? '' : 'none';
        });

        // Hide empty category blocks
        categoryBlocks.forEach((block) => {
          const visibleCards = block.querySelectorAll('[data-guide-card]:not([style*="display: none"])');
          block.style.display = visibleCards.length > 0 ? '' : 'none';
        });
      });
    }
  })();
</script>

<style>
  .docs-landing-header {
    background: var(--hero-glow);
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-badge-wrap {
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 660px;
    margin-bottom: 2rem;
  }

  .docs-search-box {
    position: relative;
    width: 100%;
    max-width: 640px;
  }

  .search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .docs-search-input {
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    font-size: 0.98rem;
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }

  .docs-search-input:focus {
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 3px var(--brand-glow);
  }

  .docs-body-section {
    padding: 3.5rem 0 5rem;
  }

  /* Quickstart Hero Card */
  .quickstart-hero-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2.5rem;
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-surface-elevated) 100%);
    border: 1px solid var(--border-strong);
    margin-bottom: 3.5rem;
  }

  @media (min-width: 900px) {
    .quickstart-hero-card {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }
  }

  .quickstart-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--brand-primary);
    background: var(--brand-primary-light);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .quickstart-title {
    font-size: clamp(1.6rem, 2.8vw, 2rem);
    margin-bottom: 0.75rem;
  }

  .quickstart-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .quickstart-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Terminal Preview */
  .quickstart-terminal {
    background: #090d16;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .terminal-bar {
    background: #0f172a;
    padding: 0.6rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dot { width: 9px; height: 9px; border-radius: 50%; }
  .dot.r { background: #ef4444; }
  .dot.y { background: #f59e0b; }
  .dot.g { background: #10b981; }

  .t-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
    margin-left: auto;
  }

  .terminal-body {
    padding: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    color: #e2e8f0;
  }

  .terminal-body p { margin-bottom: 0.5rem; }
  .p-green { color: #10b981; font-weight: bold; }
  .p-dim { color: #64748b; }
  .p-accent { color: #38bdf8; }

  /* Doc Categories */
  .doc-categories-grid {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .category-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .category-title {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .category-count {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .guides-subgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    gap: 0.75rem;
  }

  .guide-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .guide-icon {
    color: var(--brand-primary);
  }

  .guide-time {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  .guide-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .guide-card:hover .guide-card-title {
    color: var(--brand-primary);
  }

  .guide-card-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .guide-card-footer {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .read-guide-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-primary);
  }

  /* FAQ */
  .docs-faq-section {
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .faq-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .faq-question {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .faq-answer {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
