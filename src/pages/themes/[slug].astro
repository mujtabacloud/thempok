---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemePreviewGraphic from '../../components/ThemePreviewGraphic.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getAllThemes, type Theme } from '../../utils/content';
import { getRelativePath } from '../../data/site';

export async function getStaticPaths() {
  const themeEntries = await getCollection('themes');
  return themeEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'themes'>;
}

const { entry } = Astro.props;
const theme: Theme = { id: entry.id, slug: entry.id, ...entry.data };
const { Content } = await render(entry);

// Related themes: same category or featured, excluding current
const allThemesList = await getAllThemes();
const relatedThemes = allThemesList
  .filter((t) => t.id !== theme.id)
  .slice(0, 3);

const breadcrumbs = [
  { label: 'Themes', href: getRelativePath('/themes/') },
  { label: theme.title },
];
---

<BaseLayout
  title={`${theme.title} — Free Astro Theme`}
  description={theme.description}
  ogImage={theme.image ? getRelativePath(theme.image) : undefined}
>
  <div class="theme-detail-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Top Header & Actions -->
      <header class="detail-header">
        <div class="detail-header-main">
          <div class="detail-badges">
            <Badge variant="brand">{theme.category}</Badge>
            <Badge variant="success">100% Free</Badge>
            <Badge variant="neutral">MIT License</Badge>
            {theme.featured && <Badge variant="warning">Featured</Badge>}
          </div>

          <h1 class="detail-title">{theme.title}</h1>
          <p class="detail-tagline">{theme.tagline}</p>

          <div class="detail-meta-bar">
            <div class="meta-item">
              <span class="meta-label">Author</span>
              <span class="meta-value">{theme.author.name}</span>
            </div>
            <div class="meta-divider"></div>
            <div class="meta-item">
              <span class="meta-label">Version</span>
              <span class="meta-value">v{theme.version}</span>
            </div>
            <div class="meta-divider"></div>
            <div class="meta-item">
              <span class="meta-label">Updated</span>
              <span class="meta-value">{theme.lastUpdated}</span>
            </div>
            <div class="meta-divider"></div>
            <div class="meta-item">
              <span class="meta-label">Community</span>
              <span class="meta-value">
                <Icon name="star" size={13} class="text-amber" />
                <span>{theme.stars} stars</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Call to Action Buttons -->
        <div class="detail-actions-box">
          <a
            href={theme.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg action-btn"
            title="Inspect Live Demo"
          >
            <Icon name="external-link" size={18} />
            <span>Open Live Demo</span>
          </a>

          <a
            href={theme.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-lg action-btn"
            title="View theme source on GitHub (Placeholder repository)"
          >
            <Icon name="github" size={19} />
            <span>GitHub Repository</span>
          </a>

          <p class="placeholder-notice">
            <Icon name="info" size={14} />
            <span>Demo and repo links point to official Thempok preview endpoints.</span>
          </p>
        </div>
      </header>

      <!-- Large Interactive Theme Preview Canvas -->
      <section class="large-preview-section">
        <div class="preview-viewport-controls">
          <span class="preview-label">Theme Viewport Simulation</span>
          <div class="viewport-buttons" id="viewport-switcher">
            <button type="button" class="view-btn active" data-view="desktop">Desktop</button>
            <button type="button" class="view-btn" data-view="tablet">Tablet</button>
            <button type="button" class="view-btn" data-view="mobile">Mobile</button>
          </div>
        </div>

        <div class="preview-stage-container" id="preview-stage">
          <ThemePreviewGraphic theme={theme} size="large" />
        </div>
      </section>

      <!-- Main Layout: 2 Columns (Content & Sidebar Specs) -->
      <div class="detail-columns-layout">
        <div class="detail-content-left">
          <!-- Overview -->
          <section class="detail-section">
            <h2 class="section-heading">Overview</h2>
            <p class="prose-text">{theme.description}</p>
            <div class="prose-text">
              <Content />
            </div>

            <div class="highlights-grid">
              {theme.highlights.map((h) => (
                <div class="highlight-item">
                  <div class="highlight-bullet">
                    <Icon name="check" size={16} />
                  </div>
                  <div>
                    <h4 class="highlight-title">{h.title}</h4>
                    <p class="highlight-desc">{h.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Key Features -->
          <section class="detail-section">
            <h2 class="section-heading">Key Features</h2>
            <ul class="features-checklist">
              {theme.features.map((feature) => (
                <li class="feature-item">
                  <span class="feature-icon">
                    <Icon name="check" size={16} />
                  </span>
                  <span class="feature-text">{feature}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Quickstart & Installation -->
          <section class="detail-section">
            <h2 class="section-heading">Quickstart & Installation</h2>
            <p class="prose-text">
              You can initialize this theme in any directory using Astro's command-line starter or by cloning the repository:
            </p>

            <div class="install-block">
              <div class="install-header">
                <span class="install-method">Option 1: Initialize with Astro CLI</span>
              </div>
              <pre><code class="language-bash">{theme.installCommands.create}</code></pre>
            </div>

            <div class="install-block">
              <div class="install-header">
                <span class="install-method">Option 2: Git Clone & Local Setup</span>
              </div>
              <pre><code class="language-bash">{theme.installCommands.gitClone}
cd my-portfolio
{theme.installCommands.install}
{theme.installCommands.run}</code></pre>
            </div>
          </section>

          <!-- Project Structure -->
          <section class="detail-section">
            <h2 class="section-heading">Included Files & Structure</h2>
            <div class="structure-box">
              <ul class="structure-list">
                {theme.projectStructure.map((file) => (
                  <li class="structure-item">
                    <Icon name="file-text" size={15} />
                    <code>{file}</code>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        </div>

        <!-- Right Column: Sidebar Specs -->
        <aside class="detail-sidebar-right">
          <div class="card spec-card">
            <h3 class="spec-card-title">Theme Specifications</h3>

            <div class="spec-group">
              <span class="spec-label">Category</span>
              <span class="spec-val">{theme.category}</span>
            </div>

            <div class="spec-group">
              <span class="spec-label">License</span>
              <span class="spec-val">
                <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">
                  {theme.license} (Commercial & Personal)
                </a>
              </span>
            </div>

            <div class="spec-group">
              <span class="spec-label">Release Version</span>
              <span class="spec-val">v{theme.version}</span>
            </div>

            <div class="spec-group">
              <span class="spec-label">Downloads</span>
              <span class="spec-val">{theme.downloads.toLocaleString()}</span>
            </div>

            <div class="spec-divider"></div>

            <h4 class="spec-subhead">System Requirements</h4>
            <ul class="requirements-list">
              {theme.requirements.map((req) => (
                <li>
                  <Icon name="check" size={13} />
                  <span>{req}</span>
                </li>
              ))}
            </ul>

            <div class="spec-divider"></div>

            <h4 class="spec-subhead">Technologies Used</h4>
            <div class="tech-pills-wrap">
              {theme.technologies.map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>

            <div class="spec-divider"></div>

            <div class="spec-cta">
              <a href={theme.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full">
                <Icon name="external-link" size={16} />
                <span>Live Demo</span>
              </a>
              <a href={theme.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-full">
                <Icon name="github" size={16} />
                <span>Source Repository</span>
              </a>
            </div>
          </div>
        </aside>
      </div>

      <!-- Related Themes Section -->
      <section class="related-themes-section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Similar Themes You Might Like</h2>
            <p class="section-subtitle">Explore more free templates designed for high performance.</p>
          </div>
          <a href={getRelativePath('/themes/')} class="btn btn-secondary hide-mobile">
            <span>View All Themes</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="themes-grid">
          {relatedThemes.map((relTheme) => (
            <ThemeCard theme={relTheme} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const switcher = document.getElementById('viewport-switcher');
    const stage = document.getElementById('preview-stage');

    if (switcher && stage) {
      switcher.querySelectorAll('.view-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          switcher.querySelectorAll('.view-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          const view = btn.getAttribute('data-view');
          if (view === 'mobile') {
            stage.style.maxWidth = '375px';
          } else if (view === 'tablet') {
            stage.style.maxWidth = '768px';
          } else {
            stage.style.maxWidth = '100%';
          }
        });
      });
    }
  })();
</script>

<style>
  .theme-detail-page {
    padding: 2rem 0 5rem;
  }

  /* Header */
  .detail-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 900px) {
    .detail-header {
      grid-template-columns: 1fr 340px;
      align-items: center;
    }
  }

  .detail-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .detail-title {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .detail-tagline {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .detail-meta-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-value {
    font-weight: 600;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-divider {
    width: 1px;
    height: 28px;
    background: var(--border-subtle);
  }

  .text-amber {
    color: #f59e0b;
  }

  /* Actions Box */
  .detail-actions-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
  }

  .action-btn {
    width: 100%;
  }

  .placeholder-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
    margin: 0.25rem 0 0;
  }

  /* Large Preview Section */
  .large-preview-section {
    margin-bottom: 3.5rem;
  }

  .preview-viewport-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .preview-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .viewport-buttons {
    display: flex;
    gap: 4px;
    background: var(--bg-surface-elevated);
    padding: 3px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .view-btn {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .view-btn:hover {
    color: var(--text-primary);
  }

  .view-btn.active {
    background: var(--bg-surface);
    color: var(--brand-primary);
    box-shadow: var(--shadow-sm);
  }

  .preview-stage-container {
    margin: 0 auto;
    transition: max-width 300ms ease;
  }

  /* Columns Layout */
  .detail-columns-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 900px) {
    .detail-columns-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  .detail-section {
    margin-bottom: 2.75rem;
  }

  .section-heading {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .prose-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .highlight-item {
    display: flex;
    gap: 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .highlight-bullet {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-success-bg);
    color: var(--color-success);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .highlight-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .highlight-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  /* Features checklist */
  .features-checklist {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 600px) {
    .features-checklist {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
  }

  .feature-icon {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Install block */
  .install-block {
    margin-bottom: 1.5rem;
  }

  .install-header {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  /* Project structure */
  .structure-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .structure-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .structure-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  /* Sidebar right specs */
  .detail-sidebar-right {
    position: relative;
  }

  @media (min-width: 900px) {
    .detail-sidebar-right {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
      height: fit-content;
    }
  }

  .spec-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spec-card-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .spec-group {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
  }

  .spec-label {
    color: var(--text-muted);
  }

  .spec-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  .spec-val a {
    color: var(--brand-primary);
  }

  .spec-val a:hover {
    text-decoration: underline;
  }

  .spec-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 0.25rem 0;
  }

  .spec-subhead {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .requirements-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .requirements-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tech-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-pill {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    color: var(--text-secondary);
  }

  .spec-cta {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .btn-full {
    width: 100%;
  }

  /* Related section */
  .related-themes-section {
    padding-top: 3.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .themes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 480px) {
    .themes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
