---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { getRelativePath } from '../data/site';
---

<BaseLayout
  title="About Thempok — Our Mission & Open Source Philosophy"
  description="Learn why we built Thempok: to provide developers and creators with 100% free, high-performance website themes and open documentation with zero lock-in."
>
  <div class="about-page-header">
    <div class="container header-inner">
      <div class="page-badge-wrap">
        <Badge variant="brand">Our Mission</Badge>
      </div>
      <h1 class="page-title">Themes Should Be Free, Fast & Open</h1>
      <p class="page-subtitle">
        Thempok was founded to eliminate paywalled templates, predatory theme subscriptions, and bloated codebases. We build and curate pure, performant website templates for the open web.
      </p>
    </div>
  </div>

  <section class="about-content-section">
    <div class="container container-sm">
      <!-- Story Block -->
      <div class="story-block prose">
        <h2>The Story Behind Thempok</h2>
        <p>
          As web engineers, we grew frustrated by the current state of website themes. Browsing theme marketplaces meant encountering \$69 licenses with 6-month support expirations, bundled with hundreds of megabytes of unused jQuery plugins, heavy backend runtimes, and hidden subscription fees.
        </p>
        <p>
          When you just want to launch a clean developer portfolio, technical documentation site, or a marketing page, you shouldn’t have to untangle thousands of lines of spaghetti code.
        </p>
        <p>
          We created <strong>Thempok</strong> to prove there is a better way: <strong>clean, modern Astro themes licensed under the MIT license, backed by comprehensive documentation, completely free for everyone.</strong>
        </p>
      </div>

      <!-- Core Principles Grid -->
      <div class="principles-wrap">
        <h2 class="principles-heading">Our Core Guiding Principles</h2>
        <div class="principles-grid">
          <div class="card principle-card">
            <div class="principle-icon">
              <Icon name="shield" size={24} />
            </div>
            <h3 class="principle-title">100% Free Forever</h3>
            <p class="principle-desc">
              Every theme in our directory is licensed under the permissive MIT License. You can use them for personal sites, startup products, or client projects with zero fees or royalties.
            </p>
          </div>

          <div class="card principle-card">
            <div class="principle-icon">
              <Icon name="zap" size={24} />
            </div>
            <h3 class="principle-title">Zero Bloat Performance</h3>
            <p class="principle-desc">
              All themes are built on Astro's Islands architecture. They compile to pure static HTML and CSS by default, achieving 95+ to 100 Lighthouse scores with sub-second page loads.
            </p>
          </div>

          <div class="card principle-card">
            <div class="principle-icon">
              <Icon name="code" size={24} />
            </div>
            <h3 class="principle-title">Zero Vendor Lock-In</h3>
            <p class="principle-desc">
              No proprietary CMS requirement, no backend server, and no cloud platform lock-in. Deploy anywhere static files are accepted: GitHub Pages, Cloudflare Pages, Vercel, or raw Apache/Nginx.
            </p>
          </div>

          <div class="card principle-card">
            <div class="principle-icon">
              <Icon name="book" size={24} />
            </div>
            <h3 class="principle-title">Comprehensive Guides</h3>
            <p class="principle-desc">
              Themes are useless if they are impossible to configure. Every Thempok theme includes detailed step-by-step setup guides, directory architecture breakdowns, and customization documentation.
            </p>
          </div>
        </div>
      </div>

      <!-- Tech Stack Details -->
      <div class="stack-section card">
        <h2 class="stack-title">Built with Modern Web Standards</h2>
        <p class="stack-desc">
          We believe in keeping tools simple, robust, and maintainable. Thempok relies on standard web primitives:
        </p>
        <div class="stack-items">
          <div class="stack-pill">
            <span class="pill-name">Astro</span>
            <span class="pill-role">Static Engine</span>
          </div>
          <div class="stack-pill">
            <span class="pill-name">TypeScript</span>
            <span class="pill-role">Type Safety</span>
          </div>
          <div class="stack-pill">
            <span class="pill-name">CSS Variables</span>
            <span class="pill-role">Theming & Dark Mode</span>
          </div>
          <div class="stack-pill">
            <span class="pill-name">GitHub Pages</span>
            <span class="pill-role">Zero-Cost Hosting</span>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="about-faq-section">
        <h2 class="faq-main-heading">Frequently Asked Questions</h2>
        <div class="accordion-list">
          <details class="accordion-item card" open>
            <summary class="accordion-summary">
              <span>Why are all themes completely free?</span>
              <span class="accordion-indicator">+</span>
            </summary>
            <div class="accordion-body">
              <p>
                We believe basic web publishing tools should be accessible to any developer, designer, or creator in the world regardless of financial background. Open source software thrives when high-quality foundational templates are free to build upon.
              </p>
            </div>
          </details>

          <details class="accordion-item card">
            <summary class="accordion-summary">
              <span>Can I contribute my own Astro theme to Thempok?</span>
              <span class="accordion-indicator">+</span>
            </summary>
            <div class="accordion-body">
              <p>
                Yes! We welcome contributions. Check our <a href={getRelativePath('/documentation/contributing-themes/')}>Contributing Themes Guide</a> to learn about our quality standards, licensing requirements, and submission process.
              </p>
            </div>
          </details>

          <details class="accordion-item card">
            <summary class="accordion-summary">
              <span>Do I need to give credit or attribution?</span>
              <span class="accordion-indicator">+</span>
            </summary>
            <div class="accordion-body">
              <p>
                The MIT License requires retaining the copyright header in the source code files, but you are not required to display any "Powered by Thempok" badge on your public website if you prefer not to.
              </p>
            </div>
          </details>

          <details class="accordion-item card">
            <summary class="accordion-summary">
              <span>How can I support Thempok?</span>
              <span class="accordion-indicator">+</span>
            </summary>
            <div class="accordion-body">
              <p>
                The best way to support Thempok is by starring our repository on <a href="https://github.com/thempok/thempok" target="_blank" rel="noopener noreferrer">GitHub</a>, sharing our themes with fellow developers on social media, or submitting improvements and bug fixes via pull requests.
              </p>
            </div>
          </details>
        </div>
      </div>

      <!-- Bottom Callout -->
      <div class="about-cta-box">
        <h3 class="about-cta-title">Ready to build something great?</h3>
        <p class="about-cta-desc">
          Browse our collection of themes or read our documentation to get started today.
        </p>
        <div class="about-cta-buttons">
          <a href={getRelativePath('/themes/')} class="btn btn-primary btn-lg">Browse Themes</a>
          <a href={getRelativePath('/documentation/getting-started/')} class="btn btn-secondary btn-lg">Quick Start Guide</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page-header {
    background: var(--hero-glow);
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-badge-wrap {
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    margin-bottom: 0.75rem;
    max-width: 820px;
  }

  .page-subtitle {
    font-size: 1.18rem;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0;
    line-height: 1.6;
  }

  .about-content-section {
    padding: 3.5rem 0 5rem;
  }

  .story-block {
    margin-bottom: 4rem;
  }

  .story-block h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .principles-wrap {
    margin-bottom: 4rem;
  }

  .principles-heading {
    font-size: 1.8rem;
    margin-bottom: 1.75rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .principle-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .principle-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--brand-primary-light);
    color: var(--brand-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .principle-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .principle-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Stack card */
  .stack-section {
    padding: 2.5rem;
    margin-bottom: 4rem;
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-surface-elevated) 100%);
  }

  .stack-title {
    font-size: 1.45rem;
    margin-bottom: 0.5rem;
  }

  .stack-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .stack-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .stack-pill {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pill-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .pill-role {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* FAQ Accordion */
  .about-faq-section {
    margin-bottom: 4rem;
  }

  .faq-main-heading {
    font-size: 1.8rem;
    margin-bottom: 1.75rem;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .accordion-item {
    padding: 0;
    overflow: hidden;
  }

  .accordion-summary {
    padding: 1.25rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    user-select: none;
  }

  .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-indicator {
    font-size: 1.3rem;
    color: var(--text-muted);
    transition: transform var(--transition-fast);
  }

  .accordion-item[open] .accordion-indicator {
    transform: rotate(45deg);
  }

  .accordion-body {
    padding: 0 1.5rem 1.5rem 1.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .accordion-body a {
    color: var(--brand-primary);
    text-decoration: underline;
  }

  /* Bottom CTA */
  .about-cta-box {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 3rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .about-cta-title {
    font-size: 1.6rem;
    margin: 0;
  }

  .about-cta-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0;
  }

  .about-cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
