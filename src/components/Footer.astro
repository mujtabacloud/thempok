---
import { siteConfig, getRelativePath } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <!-- Top Section: Main Columns -->
  <div class="container footer-top">
    <div class="footer-brand-col">
      <a href={getRelativePath('/')} class="footer-brand-link">
        <div class="brand-symbol">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="8" fill="url(#tp-foot-grad)" />
            <path d="M9 10H23V13H17.5V23H14.5V13H9V10Z" fill="white" />
            <defs>
              <linearGradient id="tp-foot-grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                <stop stop-color="#4F46E5" />
                <stop offset="0.5" stop-color="#7C3AED" />
                <stop offset="1" stop-color="#06B6D4" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <span class="brand-name">Thempok</span>
      </a>

      <p class="brand-desc">
        A community-driven directory of high-performance, 100% free open-source website themes, clear architectural guides, and engineering articles.
      </p>

      <div class="newsletter-box">
        <label for="newsletter-email" class="newsletter-label">Get notified of new free themes:</label>
        <form class="newsletter-form" id="newsletter-form">
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder="developer@work.com"
            class="newsletter-input"
          />
          <button type="submit" class="btn btn-primary btn-sm">
            Join
          </button>
        </form>
        <p id="newsletter-msg" class="newsletter-msg" hidden>
          🎉 Thanks for subscribing! You're on the list.
        </p>
      </div>
    </div>

    <!-- Links Columns -->
    <div class="footer-links-grid">
      {siteConfig.footerSections.map((section) => (
        <div class="footer-column">
          <h4 class="footer-col-title">{section.title}</h4>
          <ul class="footer-link-list">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-link"
                  {...(link.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span>{link.label}</span>
                  {link.isExternal && <Icon name="external-link" size={12} />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Section: Copyright & Badges -->
  <div class="container footer-bottom">
    <div class="footer-bottom-content">
      <div class="copyright">
        &copy; {new Date().getFullYear()} Thempok. Released under the <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">MIT License</a>.
      </div>
      <div class="footer-meta-tags">
        <span class="meta-badge">
          <Icon name="zap" size={13} />
          Built with Astro
        </span>
        <span class="meta-badge">
          <Icon name="shield" size={13} />
          100% Free Forever
        </span>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="meta-link" aria-label="GitHub Repository">
          <Icon name="github" size={16} />
        </a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const form = document.getElementById('newsletter-form');
    const msg = document.getElementById('newsletter-msg');
    if (form && msg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.style.display = 'none';
        msg.hidden = false;
      });
    }
  })();
</script>

<style>
  .site-footer {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    margin-top: 5rem;
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  .footer-top {
    padding-top: 4rem;
    padding-bottom: 3.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: 1.3fr 2fr;
      gap: 4rem;
    }
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .brand-desc {
    color: var(--text-secondary);
    font-size: 0.93rem;
    line-height: 1.6;
    max-width: 380px;
    margin: 0;
  }

  .newsletter-box {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 360px;
  }

  .newsletter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-input {
    flex: 1;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.85rem;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .newsletter-input:focus {
    border-color: var(--brand-primary);
  }

  .newsletter-msg {
    font-size: 0.85rem;
    color: var(--color-success);
    font-weight: 600;
    margin: 0;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
  }

  .footer-col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--brand-primary);
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .footer-bottom-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom-content {
      flex-direction: row;
    }
  }

  .copyright a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .copyright a:hover {
    color: var(--brand-primary);
  }

  .footer-meta-tags {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .meta-link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .meta-link:hover {
    color: var(--text-primary);
  }
</style>
